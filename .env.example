# Supabase. Use somente a chave pública anon no navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública usada no retorno do Google OAuth.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Acesso administrativo temporário de desenvolvimento.
# Não use estas variáveis como autorização em produção.
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=

{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "QuiPraia Design System",
    "version": "1.0.0",
    "brandDirection": "3C Performance",
    "baseUnit": 4
  },
  "color": {
    "brand": {
      "midnight": { "$value": "#0B1D2D", "$type": "color" },
      "foam": { "$value": "#F4F6F7", "$type": "color" },
      "seafoam": { "$value": "#9FD3C6", "$type": "color" },
      "coral": { "$value": "#FF6B57", "$type": "color" },
      "silverBlue": { "$value": "#6B8194", "$type": "color" }
    },
    "semantic": {
      "canvas": { "$value": "#F4F6F7", "$type": "color" },
      "surface": { "$value": "#FFFFFF", "$type": "color" },
      "surfaceInverse": { "$value": "#0B1D2D", "$type": "color" },
      "textPrimary": { "$value": "#0B1D2D", "$type": "color" },
      "textSecondary": { "$value": "#52697B", "$type": "color" },
      "textInverse": { "$value": "#F4F6F7", "$type": "color" },
      "border": { "$value": "#D8E0E5", "$type": "color" },
      "action": { "$value": "#FF6B57", "$type": "color" },
      "actionHover": { "$value": "#E95745", "$type": "color" },
      "positive": { "$value": "#2E927E", "$type": "color" },
      "warning": { "$value": "#C98416", "$type": "color" },
      "danger": { "$value": "#CC4747", "$type": "color" },
      "focus": { "$value": "#2679A5", "$type": "color" }
    },
    "marine": {
      "tide": { "$value": "#57AFCB", "$type": "color" },
      "swell": { "$value": "#9FD3C6", "$type": "color" },
      "period": { "$value": "#F4B860", "$type": "color" },
      "wind": { "$value": "#6B8194", "$type": "color" },
      "now": { "$value": "#FF6B57", "$type": "color" },
      "daylight": { "$value": "#F4C76A", "$type": "color" }
    }
  },
  "font": {
    "family": {
      "display": { "$value": "Sora, system-ui, sans-serif", "$type": "fontFamily" },
      "interface": { "$value": "Inter, system-ui, sans-serif", "$type": "fontFamily" }
    },
    "weight": {
      "regular": { "$value": 400, "$type": "fontWeight" },
      "medium": { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold": { "$value": 700, "$type": "fontWeight" }
    },
    "size": {
      "xs": { "$value": "0.75rem", "$type": "dimension" },
      "sm": { "$value": "0.875rem", "$type": "dimension" },
      "md": { "$value": "1rem", "$type": "dimension" },
      "lg": { "$value": "1.125rem", "$type": "dimension" },
      "xl": { "$value": "1.5rem", "$type": "dimension" },
      "2xl": { "$value": "2rem", "$type": "dimension" },
      "3xl": { "$value": "clamp(2.5rem, 6vw, 4.5rem)", "$type": "dimension" }
    }
  },
  "space": {
    "0": { "$value": "0", "$type": "dimension" },
    "1": { "$value": "0.25rem", "$type": "dimension" },
    "2": { "$value": "0.5rem", "$type": "dimension" },
    "3": { "$value": "0.75rem", "$type": "dimension" },
    "4": { "$value": "1rem", "$type": "dimension" },
    "6": { "$value": "1.5rem", "$type": "dimension" },
    "8": { "$value": "2rem", "$type": "dimension" },
    "10": { "$value": "2.5rem", "$type": "dimension" },
    "12": { "$value": "3rem", "$type": "dimension" },
    "16": { "$value": "4rem", "$type": "dimension" },
    "20": { "$value": "5rem", "$type": "dimension" }
  },
  "radius": {
    "sm": { "$value": "0.5rem", "$type": "dimension" },
    "md": { "$value": "0.75rem", "$type": "dimension" },
    "lg": { "$value": "1rem", "$type": "dimension" },
    "xl": { "$value": "1.5rem", "$type": "dimension" },
    "full": { "$value": "999px", "$type": "dimension" }
  },
  "shadow": {
    "raised": { "$value": "0 8px 24px rgba(11,29,45,.10)", "$type": "shadow" },
    "floating": { "$value": "0 18px 48px rgba(11,29,45,.18)", "$type": "shadow" }
  },
  "motion": {
    "fast": { "$value": "120ms", "$type": "duration" },
    "base": { "$value": "220ms", "$type": "duration" },
    "slow": { "$value": "420ms", "$type": "duration" },
    "ease": { "$value": "cubic-bezier(.2,.8,.2,1)", "$type": "cubicBezier" }
  }
}

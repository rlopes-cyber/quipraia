# Supabase. Use somente a chave pública anon no navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública usada no retorno do Google OAuth.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Opcional. No piloto, o padrão usa os tiles públicos do OpenStreetMap.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
